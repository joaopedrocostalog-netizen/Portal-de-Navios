# Copie para .env (uso local) ou cadastre no Render em Environment.
# Sem DSS e sem Shipxy, tudo responde em modo demonstração ("fonte": "demo").

# DSS (TMS) – endpoint "Portal de Navios" (módulo tms_integr_portal_navios): atracações por terminal.
# Endereço completo do endpoint (DSS_URL também é aceito no lugar de NAVIOS_OF_DSS).
NAVIOS_OF_DSS=
# Login (Basic Auth). Também pode ir embutido na URL: https://usuario:senha@host/caminho
DSS_USUARIO=
DSS_SENHA=
# Se o DSS usar token em vez de usuário/senha (vai como "Authorization: Bearer ...")
DSS_TOKEN=

# Shipxy: posição dos navios e ETA pelo AIS (GetETAShips exige permissão avançada)
SHIPXY_API_KEY=

# PostgreSQL. Sem ela, os contêineres ficam em memória e somem ao reiniciar.
DATABASE_URL=
# Use true se o banco exigir SSL e o host não for *.render.com
DATABASE_SSL=false

PORT=3000
# Código de porto da Shipxy (pode diferir do UN/LOCODE; descubra em /api/portos?busca=santos)
PORTO_PADRAO=BRSSZ
# Nome do porto usado no diagnóstico da inicialização (SearchPort)
PORTO_NOME=Santos
# false desliga as consultas de diagnóstico à Shipxy feitas ao iniciar
VERIFICAR_FONTES=true
DIAS_PADRAO=7
TOLERANCIA_DIVERGENCIA_HORAS=24
INTERVALO_TEMPO_REAL_MS=60000
TIMEOUT_HTTP_MS=15000
# Origens permitidas para chamar a API do navegador, separadas por vírgula (ou *)
CORS_ORIGIN=*

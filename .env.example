# Endpoint da API Portal de Navios do DSS
DSS_URL=https://costalog.dssinformatica.com.br/wsdss/navios/listarNavios
# Usuário de integração do DSS (Basic Auth). Também podem ir na URL: https://usuario:senha@host/...
DSS_USUARIO=
DSS_SENHA=
# Só se o DSS autenticar por token (Authorization: Bearer)
DSS_TOKEN=

# PostgreSQL do histórico de mudanças (sem ela, o histórico fica em memória)
DATABASE_URL=

# Alertas por e-mail (o Render gratuito bloqueia SMTP: use a API do Resend ou do Brevo)
ALERTA_PARA=joao.pedro@costalog.com.br
RESEND_API_KEY=
BREVO_API_KEY=
ALERTA_DE=
ALERTA_MINUTOS=15
ALERTA_DEADLINE_HORAS=24
ALERTA_MUDANCA_MIN_HORAS=1
ALERTA_FILTRO=

PORT=3000
# Intervalo da consulta ao DSS em segundo plano
CACHE_SEGUNDOS=60
# Ping no próprio endereço para o Render não hibernar (no Render a URL é automática)
MANTER_ACORDADO=true
PING_MINUTOS=10
URL_PUBLICA=
# Origem permitida para chamar a API de outro site
CORS_ORIGIN=*
